# ─── Core infrastructure ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Vector store (optional — PostgreSQL cosine fallback works without it)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ethiopian_legal_chunks

# ─── Embeddings (BAAI/bge-m3 via Hugging Face Inference Providers) ─────
HF_TOKEN=
HF_MODEL=BAAI/bge-m3

# ─── LLM (OpenRouter-compatible) ───────────────────────────────────────
OPENROUTER_API_KEY=
LLM_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
ADMIN_TOKEN=
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# ─── Retrieval tuning ──────────────────────────────────────────────────
RETRIEVE_TOP_K=20
RERANK_TOP_K=6
CONTEXT_CHUNKS=6
CONFIDENCE_STRONG=0.55
CONFIDENCE_MODERATE=0.32
